# Database (MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app-name>"

# JWT Authentication Settings
SECRET_KEY="change-me-to-a-long-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# File Storage Configuration
AUDIO_STORAGE_PATH="./storage"
MAX_UPLOAD_MB="50"

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Initial Admin User Credentials
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@resonance.com"
ADMIN_PASSWORD="admin123"